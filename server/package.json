{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run --env-file .env --overload -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "dotenvx run --env-file .env --overload -- tsx prisma/seed.ts",
    "start:test": "dotenvx run --env-file .env.test --overload -- tsx src/index.ts",
    "db:migrate:test": "dotenvx run --env-file .env.test --overload -- prisma migrate deploy",
    "db:seed:test": "dotenvx run --env-file .env.test --overload -- tsx prisma/seed.ts"
  },
"dependencies": {
    "@ai-sdk/openai": "^3.0.33",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@sendgrid/inbound-mail-parser": "^8.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.42.0",
    "@types/multer": "^2.0.0",
    "ai": "^6.0.100",
    "better-auth": "^1.4.18",
    "core": "*",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "multer": "^2.1.0",
    "pg-boss": "^12.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.61.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.2",
    "prisma": "^7.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5"
  }
}
