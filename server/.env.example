PORT=5000
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:5000
DATABASE_URL=
SESSION_SECRET=your-secret-key-change-in-production
BETTER_AUTH_SECRET=                   # min 32 chars, generate with: openssl rand -base64 32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=                        # min 8 chars
AGENT_PASSWORD=                        # optional; falls back to ADMIN_PASSWORD if unset
INBOUND_WEBHOOK_SECRET=               # secret token appended as ?secret= to the SendGrid webhook URL
GEMINI_API_KEY=                        # Google AI Studio API key for all AI features

# ---------------------------------------------------------------------------
# E2E / Playwright test overrides (used by e2e/helpers/auth.ts)
# These default to the values in server/.env.test when unset.
# Override here or in CI environment to match your seeded test users.
# ---------------------------------------------------------------------------
TEST_ADMIN_EMAIL=                      # defaults to admin@example.com
TEST_ADMIN_PASSWORD=                   # defaults to Admin1234!
TEST_AGENT_EMAIL=                      # defaults to agent@example.com
TEST_AGENT_PASSWORD=                   # defaults to Agent1234!
