PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5000
DATABASE_URL=postgresql://postgres:1234@localhost:5432/solutionDesk?schema=public
BETTER_AUTH_SECRET=                   # min 32 chars, generate with: openssl rand -base64 32

# Admin User Seeding
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123       # min 8 chars
ADMIN_EMAIL=admin@example.com         # alias for SEED_ADMIN_EMAIL
ADMIN_PASSWORD=password123            # alias for SEED_ADMIN_PASSWORD

# Inbound Webhook Secret
WEBHOOK_SECRET=test-webhook-secret
INBOUND_WEBHOOK_SECRET=test-webhook-secret # alias for WEBHOOK_SECRET

# Google Gemini AI API Key
GEMINI_API_KEY=                        # Google AI Studio API key for all AI features

# Braintrust (Eval & Observability Tracing)
BRAINTRUST_API_KEY=                    # Braintrust API key (optional, falls back to local logging)

# Lakera Guard AI Security (Prompt Injection & PII Screening)
LAKERA_GUARD_API_KEY=                  # Lakera Guard API key (api.lakera.ai/v2/guard)

# Email Provider (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@example.com

# Sentry Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# E2E / Playwright test overrides (used by e2e/helpers/auth.ts)
# ---------------------------------------------------------------------------
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=Admin1234!
TEST_AGENT_EMAIL=agent@example.com
TEST_AGENT_PASSWORD=Agent1234!
