PORT=5000
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:5000
DATABASE_URL="postgresql://postgres:password@localhost:5432/solutiondesk"
SESSION_SECRET=your-secret-key-change-in-production
BETTER_AUTH_SECRET=                   # min 32 chars, generate with: openssl rand -base64 32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=                        # min 8 chars
AGENT_PASSWORD=                        # optional; falls back to ADMIN_PASSWORD if unset
